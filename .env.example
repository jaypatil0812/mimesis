MEMESIS_DATABASE_URL=postgresql+psycopg://memesis:memesis@localhost:5432/memesis
MEMESIS_LOG_LEVEL=INFO
MEMESIS_ENVIRONMENT=development
MEMESIS_INGESTION_USER_AGENT=Memesis/0.1 (+https://github.com/memesis)
MEMESIS_INGESTION_REQUEST_TIMEOUT_SECONDS=20
MEMESIS_INGESTION_MAX_RETRIES=2
MEMESIS_INGESTION_RETRY_BACKOFF_SECONDS=0.5
MEMESIS_INGESTION_CACHE_TTL_SECONDS=300
# Optional: improves OpenAlex's polite-pool identification; do not commit a key.
MEMESIS_OPENALEX_API_KEY=
# Optional model fallback. Leave unset for deterministic-only graph projection.
# Any OpenAI-compatible /chat/completions endpoint can be used.
MEMESIS_MODEL_API_BASE_URL=https://api.openai.com/v1
MEMESIS_MODEL_API_KEY=
MEMESIS_EXTRACT_SMALL_MODEL=
MEMESIS_RESOLVE_SMALL_MODEL=
MEMESIS_REASON_STRONG_MODEL=
MEMESIS_REASONING_TIMEOUT_SECONDS=60
MEMESIS_REASONING_MAX_PACKET_TOKENS=24000
# Optional; checks whether cited passages bear on claims. Exploratory hypotheses
# remain in the answer and are never filtered by this advisory check.
MEMESIS_VERIFY_CLAIM_SUPPORT=false
# Phase 9 decision engine. Without keys, hybrid uses an offline simulation.
MEMESIS_DECISION_ENGINE=hybrid
MEMESIS_TYPESAFE_API_KEY=
MEMESIS_TYPESAFE_BASE_URL=https://api.typesafe.ai
MEMESIS_TYPESAFE_MODEL=jev-1.13
MEMESIS_OPENROUTER_API_KEY=
